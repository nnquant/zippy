from typing import Any

class ShmReader:
    def __init__(
        self,
        descriptor_json: str,
        schema_json: str,
        start_from: int = ...,
    ) -> None: ...
    def read_available(self) -> Any | None: ...
    def committed_row_count(self) -> int: ...
    def is_sealed(self) -> bool: ...
    def notification_sequence(self) -> int: ...
    def wait_for_notification_after(
        self,
        observed: int,
        timeout_ms: int,
        idle_spin_checks: int = ...,
    ) -> bool: ...
    def spin_for_notification_after(self, observed: int, checks: int) -> bool: ...
    def try_rebind(self, descriptor_json: str) -> tuple[bool, Any | None]: ...
    def control_snapshot(self) -> dict[str, object]: ...

PROTOCOL_VERSION: int
__version__: str
